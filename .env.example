# Frontend env — คัดลอกไฟล์นี้เป็น ".env" (cp .env.example .env)
# Vite จะส่งเฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_ เข้าไปใน bundle ฝั่ง client

# ให้ frontend เรียก API แบบ relative "/api" เสมอ แล้วให้ vite เป็นตัว proxy
# (อย่าใส่ host เต็ม ไม่งั้นจะข้าม proxy แล้วเจอปัญหา CORS/cookie)
VITE_API_BASE_URL=/api

# ปลายทางที่ vite จะ proxy "/api" ไป — เลือก 1 โหมด:
#   โหมด A (ง่าย, ทำ UI): ไม่ต้องตั้ง → default ชี้ production ให้อ่านข้อมูลจริงได้เลย
#   โหมด B (full-stack, รัน backend เอง): ตั้งเป็น backend local ของคุณ
# VITE_DEV_API_PROXY=http://localhost:3000
