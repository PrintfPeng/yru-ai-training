# ===================================================================
#  backend/.env — คัดลอกไฟล์นี้เป็น ".env" แล้วแก้ค่าตามเครื่องของคุณ
#  (cp .env.example .env)
# ===================================================================

# ----- Server -----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
# โดเมนของ frontend ที่อนุญาตให้เรียก API (dev = vite ที่ 5173)
CORS_ORIGINS=http://localhost:5173

# ----- Database (MySQL 8) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yru_ai_training_db
DB_USER=yru_app_user
DB_PASSWORD=your_db_password_here
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+07:00

# ----- Auth / JWT -----
# ต้องยาวอย่างน้อย 32 ตัวอักษร — สร้างได้ด้วย:  openssl rand -hex 24
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=yru_admin_token
# dev ใช้ http → ต้องเป็น false (ไม่งั้น browser ไม่เก็บ cookie แล้ว login ไม่ติด)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ----- Misc -----
BCRYPT_COST=10
# true เฉพาะเมื่ออยู่หลัง reverse proxy (nginx) บน production
TRUST_PROXY=false
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=5
