# =============================================================================
# YRU AI Training Backend — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000

# Bind address:
#   - 0.0.0.0  → all interfaces (production on 10.20.41.108)
#   - 127.0.0.1 → localhost only (dev)
HOST=0.0.0.0

# Base URL used for building QR/verification URLs
PUBLIC_BASE_URL=http://10.20.41.108:3000

# --- CORS ---
# Comma-separated whitelist. Frontend dev + prod origins:
CORS_ORIGINS=http://localhost:5173,http://10.20.41.108

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yru_ai_training_db
DB_USER=yru_app_user
DB_PASSWORD=CHANGE_ME_TO_MATCH_02_create_user_sql
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+07:00

# --- JWT (access token in httpOnly cookie) ---
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h
COOKIE_NAME=yru_admin_token
# COOKIE_SECURE=true in production (requires HTTPS). Only "true"/"1"/"yes"/"on" enable it.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- bcrypt ---
BCRYPT_COST=10

# --- Proxy / rate limiting ---
# TRUST_PROXY=true only when behind nginx (production). Enables trusting
# X-Forwarded-For so rate limits key on the real client IP. Leave false
# for bare `node src/server.js` runs so the limiter can't be spoofed.
TRUST_PROXY=false
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=5
